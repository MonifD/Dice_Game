{
  "name": "last-war-arene",
  "version": "1.0.0",
  "description": "Mini-jeux d'élimination en temps réel pour une alliance Last War: Survival (jusqu'à 100 joueurs).",
  "main": "src/serveur.js",
  "scripts": {
    "start": "node src/serveur.js",
    "dev": "node --watch src/serveur.js",
    "postinstall": "prisma generate",
    "db:migrer": "prisma migrate deploy",
    "db:nouvelle-migration": "prisma migrate dev",
    "db:questions": "node prisma/seed.js",
    "vercel-build": "prisma generate && prisma migrate deploy",
    "test": "node --test tests/*.test.js",
    "test:charge": "node tests/charge.js --joueurs 100 --tous",
    "superadmin": "node prisma/superadmin.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "6.19.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
