# =============================================================
#  Copie ce fichier en « .env » et remplis les valeurs.
#  Sur Vercel / Render : ajoute les mêmes variables dans le tableau de bord.
# =============================================================

# --- Base PostgreSQL (Neon, Supabase ou locale) ---
# Neon : DATABASE_URL = URL « pooled » (…-pooler…), DIRECT_URL = URL directe (pour les migrations)
# En local avec docker compose : les deux identiques.
DATABASE_URL="postgresql://lastwar:lastwar@localhost:5432/lastwar"
DIRECT_URL="postgresql://lastwar:lastwar@localhost:5432/lastwar"

# --- Redis (Upstash, Redis Cloud…) ---
# Obligatoire dès qu'il y a plusieurs instances (Vercel). Laisse vide en local : stockage en mémoire.
# Upstash : utilise l'URL « rediss://default:MOT_DE_PASSE@xxx.upstash.io:6379 »
REDIS_URL=""

# --- Sécurité ---
# Longue chaîne aléatoire. Génère-la avec :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_DUREE="7d"

# --- Super admin (toi) : créé automatiquement au démarrage s'il n'existe pas ---
SUPER_ADMIN_PSEUDO="TonPseudoLastWar"
SUPER_ADMIN_MOT_DE_PASSE="change-moi-vite"

# --- Optionnel ---
PORT=3000
# Nombre max de joueurs dans une salle
MAX_JOUEURS_PAR_SALLE=150
# Connexions PostgreSQL max par instance
DB_CONNEXIONS_MAX=10
# Si le site et le serveur temps réel sont sur deux domaines différents
# (ex. pages sur Vercel, temps réel sur Render) :
#   sur le serveur temps réel : ORIGINES_AUTORISEES="https://mon-site.vercel.app"
#   sur le site : URL_TEMPS_REEL="https://mon-serveur.onrender.com"
ORIGINES_AUTORISEES=""
URL_TEMPS_REEL=""
