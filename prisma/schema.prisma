// =============================================================
//  Schéma de base de données — Last War : Jeux d'élimination
//  PostgreSQL (Neon / Supabase / local) via Prisma
// =============================================================

generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (sans pooler) utilisée par les migrations (Neon/Supabase).
  directUrl = env("DIRECT_URL")
}

/// Rôle applicatif (droits d'administration)
enum Role {
  JOUEUR
  ADMIN
  SUPER_ADMIN
}

/// Rang dans l'alliance Last War
enum Rang {
  R1
  R2
  R3
  R4
  R5
}

enum StatutPartie {
  ATTENTE
  EN_COURS
  TERMINEE
  ANNULEE
}

/// Ce que le gagnant de la partie obtient (raison d'être des jeux)
enum ObjetPartie {
  CONDUCTEUR // conducteur du train
  VIP // VIP du train
  AMUSEMENT // « Pour s'amuser » : aucune désignation
}

/// Origine d'une ligne de désignation Conducteur / VIP
enum ModeDesignation {
  PARTIE // gagnant d'une partie
  MANUELLE // modifiée / retirée à la main par un R4, R5 ou admin
  SUPPRESSION // compte supprimé : la désignation passe à « Non désigné »
}

/// Table « joueurs »
model Joueur {
  id               Int             @id @default(autoincrement())
  pseudo           String          @unique // pseudo exact dans Last War
  pseudoNormalise  String          @unique // minuscule, sans espaces superflus : évite les doublons « Bob » / « bob »
  motDePasseHash   String // bcrypt, jamais le mot de passe en clair
  rang             Rang            @default(R1)
  role             Role            @default(JOUEUR)
  actif            Boolean         @default(true) // false = compte bloqué
  dateInscription  DateTime        @default(now())
  derniereConnexion DateTime?
  doitChangerMdp   Boolean         @default(false) // mot de passe temporaire donné par un R4 / R5 / admin
  supprimeLe       DateTime? // compte supprimé : la ligne reste pour l'historique
  pseudoSupprime   String? // pseudo d'origine d'un compte supprimé (le pseudo est libéré)

  partiesOrganisees Partie[]        @relation("Organisateur")
  partiesGagnees    Partie[]        @relation("Gagnant")
  participations    Participation[]
  designations      Designation[]   @relation("Designe")

  @@map("joueurs")
}

/// Table « parties »
model Partie {
  id               Int             @id @default(autoincrement())
  code             String          @unique // identifiant court de la salle (ex. « K7Q2PX »)
  miniJeu          String // identifiant du module (ex. « des »)
  objet            ObjetPartie? // Conducteur, VIP du train ou « Pour s'amuser » (vide pour les parties d'avant)
  dateObjet        DateTime?    @db.Date // jour J où le gagnant sera Conducteur / VIP (vide pour « Pour s'amuser »)
  parametres       Json
  statut           StatutPartie    @default(ATTENTE)
  dateCreation     DateTime        @default(now())
  dateDebut        DateTime?
  dateFin          DateTime?
  nbParticipants   Int             @default(0)
  nbTours          Int             @default(0)

  organisateurId   Int
  organisateur     Joueur          @relation("Organisateur", fields: [organisateurId], references: [id])
  gagnantId        Int?
  gagnant          Joueur?         @relation("Gagnant", fields: [gagnantId], references: [id])

  participations   Participation[]

  @@index([dateCreation])
  @@index([objet, statut, dateObjet])
  @@map("parties")
}

/// Désignations Conducteur / VIP par jour (une ligne par changement).
/// La ligne « active » d'un (objet, jour) est la désignation en vigueur ; joueurId vide = « Non désigné ».
model Designation {
  id           Int             @id @default(autoincrement())
  objet        ObjetPartie // CONDUCTEUR ou VIP
  jour         DateTime        @db.Date // jour J (un jour commence à 3h00, heure de Paris)
  joueurId     Int?
  joueur       Joueur?         @relation("Designe", fields: [joueurId], references: [id], onDelete: SetNull)
  mode         ModeDesignation
  partieId     Int? // partie gagnée (mode PARTIE)
  auteurId     Int? // qui a fait la modification (mode MANUELLE / SUPPRESSION)
  ancienPseudo String? // personne désignée avant ce changement
  active       Boolean         @default(true)
  creeLe       DateTime        @default(now())
  remplaceeLe  DateTime?

  @@index([objet, jour, active])
  @@index([jour])
  @@map("designations")
}

/// Table « participations »
model Participation {
  id             Int     @id @default(autoincrement())
  joueurId       Int
  partieId       Int
  tourAtteint    Int     @default(0) // dernier tour joué
  positionFinale Int? // 1 = gagnant ; les éliminés au même tour partagent la même position

  joueur Joueur @relation(fields: [joueurId], references: [id], onDelete: Cascade)
  partie Partie @relation(fields: [partieId], references: [id], onDelete: Cascade)

  @@unique([joueurId, partieId])
  @@map("participations")
}

/// Questions du quiz (gérées depuis l'administration)
model QuestionQuiz {
  id           Int      @id @default(autoincrement())
  categorie    String   @default("Last War") // « Last War » ou « Culture générale »
  question     String
  choix        String[] // 2 à 4 réponses possibles
  bonneReponse Int // index dans « choix »
  active       Boolean  @default(true)
  dateCreation DateTime @default(now())

  @@map("questions_quiz")
}

/// Journal des actions sensibles (consultable par le super admin)
model Journal {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  auteurId Int?
  action   String
  details  Json?

  @@index([date])
  @@map("journaux")
}
